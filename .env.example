# Copy to .env and fill in. Never commit .env.

# Groq Cloud (free tier) — https://console.groq.com/keys
GROQ_API_KEY=

# Optional — only if you call Gemini via ai.llm_providers (not required for Groq self-play)
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Optional model overrides (defaults are free-tier friendly)
# GROQ_MODEL=llama-3.1-8b-instant
# GEMINI_MODEL=gemini-2.0-flash

# Pace Groq calls (default ~25 RPM ≈ 2.5s between requests). Disable with:
#   GROQ_PACE_RPM=0
# Or set an explicit gap (wins over GROQ_PACE_RPM when > 0):
#   GROQ_MIN_INTERVAL_SECONDS=2.05

# Groq-only headless games + Q-learning checkpoint (default: data/ai_agent.pkl):
#   PYTHONPATH=src python -m llm_selfplay --games 1 -v
